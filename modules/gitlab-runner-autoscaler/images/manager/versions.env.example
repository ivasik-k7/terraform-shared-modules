# Pins for the manager image. Copy to versions.env, fill in, commit: the file
# is the record of what is in the image. No secrets belong here.

# GitLab Runner. Its major.minor matches GitLab's; the module's runner_version
# and the helper image use the same value.
RUNNER_VERSION=18.6.1
# The official image, Alpine flavour, through the registry mirror. A digest
# (...:alpine-v18.6.1@sha256:...) pins it further.
BASE_IMAGE=registry-mirror.example.internal/gitlab/gitlab-runner:alpine-v18.6.1

# fleeting-plugin-aws: the release asset fleeting-plugin-aws-linux-amd64, and
# its line in the release's release.sha256.
# https://gitlab.com/gitlab-org/fleet-plugins/aws/-/releases
PLUGIN_VERSION=1.3.2
PLUGIN_URL=https://artifacts.example.internal/fleeting-plugin-aws/v1.3.2/fleeting-plugin-aws-linux-amd64
PLUGIN_SHA256=

# docker-credential-ecr-login comes from the Alpine community repository.
# ALPINE_MIRROR replaces the public CDN in the image's apk repositories, for
# example https://artifacts.example.internal/alpine (empty: the public CDN).
# ECR_LOGIN_VERSION pins the package, for example 0.10.1-r3 (empty: the version
# the base image's Alpine release carries).
ALPINE_MIRROR=
ECR_LOGIN_VERSION=

# Output: your ECR repository for the manager, and a build number that moves
# whenever anything above does. With immutable tags on the repository, a reused
# tag fails the push instead of replacing the image.
TARGET_REPOSITORY=111122223333.dkr.ecr.eu-west-1.amazonaws.com/ci/gitlab-runner-manager
IMAGE_REVISION=1
