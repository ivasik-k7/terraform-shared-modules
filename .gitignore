################################################################################
# Terraform
################################################################################

# Local .terraform directories
**/.terraform/*
.terraform.lock.hcl

# .tfstate files (contains sensitive data)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json
!example.tfvars
!example.tfvars.json

# Ignore override files, as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan

################################################################################
# IDE & Editor
################################################################################

# Visual Studio Code
# .vscode/* rather than .vscode/, because git cannot re-include a file whose
# parent directory is excluded - and the agent permission list below is a
# security control, so it belongs in review rather than in local settings.
.vscode/*
!.vscode/settings.json
*.code-workspace
.history/

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
.vim/
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
.\#*

# Nano
.nano_history

################################################################################
# OS Specific Files
################################################################################

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory

################################################################################
# Environment Files
################################################################################

# Environment variables
.env
.env.local
.env.*.local
.envrc
.direnvrc

# Secrets
**/secrets/
**/*secret*
**/*credentials*
**/*key.pem
**/*key.json
*.key
*.p12
*.pfx

# The name patterns above also matched source files (a runner's secrets.py,
# a secretsmanager.rego policy), which then silently never reached CI.
# Source is never secret material; re-include it by extension.
!**/*secret*.tf
!**/*secret*.tftpl
!**/*secret*.hcl
!**/*secret*.py
!**/*secret*.rego
!**/*secret*.sh
!**/*secret*.md
!**/*credentials*.tf
!**/*credentials*.py
!**/*credentials*.md

################################################################################
# Dependency Management
################################################################################

# Go dependencies
vendor/
go.sum

# Node modules (if using any Node-based tools)
node_modules/
package-lock.json
yarn.lock

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

################################################################################
# Logs & Temporary Files
################################################################################

# Logs
*.log
logs/
*.log.*

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Caches
.cache/
cache/

# OS temp directories
/tmp/
/temp/

################################################################################
# Build & Test Artifacts
################################################################################

# Build outputs
/build/
/dist/
/target/

# Test coverage
coverage/
*.coverage
.coverage

# Test outputs
test-results/
junit.xml

################################################################################
# Documentation
################################################################################

# Generated docs (if applicable)
/docs/_build/
site/

################################################################################
# Project Specific
################################################################################

# Local testing artifacts
test-fixtures/
local-testing/

# Temporary workspace files
*.bak
*.backup
.terraform.lock.hcl

cost-projection-aws-migration.md
################################################################################
# Local agent/task specification files (kept on disk, not shipped with modules)
################################################################################
modules/*/REQ.txt
modules/*/creq.txt

################################################################################
# Local tooling state
################################################################################
# Windows attaches these to files downloaded into WSL.
*:Zone.Identifier
# Personal Claude Code overrides; .claude/settings.json is the shared one.
.claude/settings.local.json
.claude/worktrees/
